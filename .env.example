# --- Base de données (PostgreSQL) ---
# En production : utilisez une base Postgres hebergee gratuite, par ex. Neon (https://neon.tech) ou Supabase.
# DATABASE_URL : connexion "pooled" (avec pgbouncer/-pooler dans l'hote), utilisee par l'application.
DATABASE_URL="postgresql://user:password@host-pooler:5432/database?sslmode=require"
# DIRECT_URL : connexion DIRECTE (sans pooler), utilisee uniquement par "prisma migrate deploy".
# Sur Neon : dans "Connect", desactivez le bouton "Pooled connection" pour obtenir cette URL
# (meme host mais SANS "-pooler"). Obligatoire : les connexions poolees ne supportent pas le
# verrou de migration de Prisma (erreur P1002 / advisory lock timeout sinon).
DIRECT_URL="postgresql://user:password@host:5432/database?sslmode=require"

# --- Authentification administrateur ---
# Email utilise pour se connecter a /admin
ADMIN_EMAIL="admin@example.com"
# Hash bcrypt du mot de passe administrateur (jamais le mot de passe en clair).
# Generez-le avec : node scripts/hash-password.js "VotreMotDePasse"
# IMPORTANT : dans un fichier .env local, chaque "$" du hash doit être échappé en "\$"
# (sinon Next.js essaie de les interpréter comme des variables). Le script génère
# déjà la version échappée à copier ici. Sur Vercel (variables d'environnement du
# dashboard), collez le hash SANS échappement.
ADMIN_PASSWORD_HASH="\$2a\$10\$replace-with-generated-hash"
# Chaine secrete aleatoire et longue, utilisee pour signer les sessions admin.
# Generez-la avec : openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-secret"

# --- Stockage des images (Vercel Blob) ---
# Cree automatiquement quand vous activez "Blob" dans votre projet Vercel (Storage > Create Database > Blob).
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# --- Coordonnees boutique (optionnel, deja definies en dur dans le code mais surchargeables) ---
NEXT_PUBLIC_SITE_URL="https://votre-domaine.vercel.app"
NEXT_PUBLIC_WHATSAPP_NUMBER="221783817581"
