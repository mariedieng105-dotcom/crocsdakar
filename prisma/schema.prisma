generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// ABANDONNÉ. Le client a choisi de s'en tenir aux quatre familles réellement
/// présentes dans le catalogue (classiques, personnages, collaborations,
/// sandales), déduites du slug dans src/lib/families.ts. Plus aucun écran ni
/// aucune route n'utilise ce champ.
///
/// La colonne et l'enum restent en base à dessein : les supprimer demanderait
/// une migration destructive, or `prisma migrate deploy` s'exécute pendant le
/// build, y compris celui d'un déploiement Preview. Tant qu'il n'est pas
/// établi que Preview vise une base distincte de la production, cette
/// suppression ne doit pas partir. La colonne a une valeur par défaut, elle ne
/// gêne aucune écriture.
enum ProductCategory {
  FEMME
  HOMME
  ENFANT
  ACCESSOIRES
  A_CLASSER
}

enum OrderStatus {
  NOUVELLE
  CONFIRMEE
  EN_PREPARATION
  LIVREE
  ANNULEE
}

model Product {
  id          String          @id @default(cuid())
  name        String
  model       String
  slug        String          @unique
  price       Int?
  description String          @db.Text
  /// Voir le commentaire de l'enum ProductCategory : champ abandonné, conservé
  /// en base faute de pouvoir lancer une migration destructive en Preview.
  category    ProductCategory @default(A_CLASSER)
  available   Boolean         @default(true)
  quantity    Int?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  images ProductImage[]
  sizes  ProductSize[]
  orderItems OrderItem[]

  @@index([createdAt])
  @@index([available])
  @@index([category])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String  @default("")
  position  Int     @default(0)
  isMain    Boolean @default(false)

  @@index([productId])
}

model ProductSize {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  available Boolean @default(true)

  @@unique([productId, label])
  @@index([productId])
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  customerName  String
  phone         String
  address       String
  zone          String?
  notes         String?     @db.Text
  subtotal      Int
  deliveryFee   Int?
  total         Int
  status        OrderStatus @default(NOUVELLE)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  items OrderItem[]

  @@index([createdAt])
  @@index([status])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  model       String
  size        String
  quantity    Int
  unitPrice   Int
  lineTotal   Int

  @@index([orderId])
}
